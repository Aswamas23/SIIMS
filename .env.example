# ============================================================
# SIIMS — Environment Configuration Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# ----- Database -----
POSTGRES_DB=siims
POSTGRES_USER=siims
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgresql+asyncpg://siims:change-me-to-a-strong-password@localhost:5432/siims

# ----- Backend Security -----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-long-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Backend URLs -----
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ----- Admin Seed Account (used by database/seed_data.py) -----
ADMIN_EMAIL=admin@school.edu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeOnFirstLogin!
ADMIN_FULL_NAME=System Administrator

# ----- Email (SMTP) -----
# Optional — leave blank to disable email notifications (dashboard-only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siims@school.edu
SMTP_TLS=true

# ----- Monitoring thresholds (defaults used if not in DB) -----
CPU_WARNING_PERCENT=90
RAM_WARNING_PERCENT=90
DISK_WARNING_PERCENT=90
DISK_CRITICAL_PERCENT=95
OFFLINE_TIMEOUT_MINUTES=10
HEARTBEAT_INTERVAL_SECONDS=60
DATA_RETENTION_DAYS=30
