# ============================================================
# SIIMS — Docker Compose Environment Template
# Copy to ".env" next to docker-compose.yml and fill in values.
# ============================================================

# ----- PostgreSQL -----
POSTGRES_DB=siims
POSTGRES_USER=siims
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ----- Backend -----
SECRET_KEY=generate-a-long-random-secret-key-here
DATABASE_URL=postgresql+asyncpg://siims:change-me-to-a-strong-password@postgres:5432/siims
FRONTEND_URL=http://localhost

# ----- Admin seed account -----
ADMIN_EMAIL=admin@school.edu
ADMIN_PASSWORD=ChangeMeOnFirstLogin!
ADMIN_FULL_NAME=System Administrator

# ----- Email (SMTP) — optional -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siims@school.edu
SMTP_TLS=true
